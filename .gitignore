# Root .gitignore — front/ and back/ have their own.

# ── graphify ──────────────────────────────────────────────
# Only the shared graph is committed: graph.json, GRAPH_REPORT.md,
# .graphify_labels.json. Everything else is local or can be regenerated
# (graph.html: `graphify export html`).
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/.graphify_labels.json

# ── Editor / OS ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
